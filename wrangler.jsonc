{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studio",
  "main": "server/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": { "enabled": true },
  "alias": {
    "@shared/config": "./shared/config.ts",
    "@shared/config-schema": "./shared/config-schema.ts",
    "@shared/prompts": "./shared/prompts.ts",
    "@shared/naming": "./shared/naming.ts",
    "@shared/types": "./shared/types.ts",
    "@shared/editorial-skill": "./shared/editorial-skill.ts",
    "@shared/pricing": "./shared/pricing.ts",
    "@shared/skills": "./shared/skills.ts",
    "@shared/zaid": "./shared/zaid.ts",
    "@shared/safety": "./shared/safety.ts",
    "@shared/paths": "./shared/paths.ts",
    "@shared/direction-rules": "./shared/direction-rules.ts",
    "@shared/zip-parts": "./shared/zip-parts.ts",
    "@shared/clients": "./shared/clients.ts",
    "@shared/posts": "./shared/posts.ts",
    "@shared/overlay": "./shared/overlay.ts",
    "@shared/brief": "./shared/brief.ts",
    "@shared/campaign": "./shared/campaign.ts",
    "@shared/draft": "./shared/draft.ts",
    "@shared/conflicts": "./shared/conflicts.ts",
    "@shared/client-changes": "./shared/client-changes.ts",
    "@shared/ideas-chat": "./shared/ideas-chat.ts",
    "@shared/memory": "./shared/memory.ts",
    "@shared/photography": "./shared/photography.ts",
    "@shared/occasions": "./shared/occasions.ts",
    "@shared/qa": "./shared/qa.ts",
    "@shared/video-models": "./shared/video-models.ts",
    "@shared/promptbox": "./shared/promptbox.ts",
    "@shared/brandMemory": "./shared/brandMemory.ts",
    "@shared/cast": "./shared/cast.ts",
    "@shared/styles": "./shared/styles.ts",
    "@shared/profile": "./shared/profile.ts",
    "@shared/typography": "./shared/typography.ts",
    "@shared/layers": "./shared/layers.ts",
    "@shared/svg-colors": "./shared/svg-colors.ts",
    "@shared/language": "./shared/language.ts",
    "@shared/text-assist": "./shared/text-assist.ts",
    "@shared/realism": "./shared/realism.ts",
    "@shared/audit": "./shared/audit.ts",
    "@shared/skillbook": "./shared/skillbook.ts",
    "@shared/autopilot": "./shared/autopilot.ts",
    "@shared/drive": "./shared/drive.ts",
    "@shared/testgrid": "./shared/testgrid.ts",
    "@shared/issues": "./shared/issues.ts",
    "@shared/ocr-check": "./shared/ocr-check.ts",
    "@shared/feedback": "./shared/feedback.ts",
    "@shared/video-audio": "./shared/video-audio.ts",
    "@shared/music": "./shared/music.ts",
    "@shared/music-catalog": "./shared/music-catalog.ts",
    "@shared/music-test-audio": "./shared/music-test-audio.ts",
    "@shared/publish": "./shared/publish.ts",
    "@shared/grid-preview": "./shared/grid-preview.ts",
    "@shared/campaign-size": "./shared/campaign-size.ts",
    "@shared/video-project": "./shared/video-project.ts",
    "@shared/cube-lut": "./shared/cube-lut.ts",
    "@shared/photo-adjust": "./shared/photo-adjust.ts",
    "@shared/client-hold": "./shared/client-hold.ts",
    "@shared/video-presets": "./shared/video-presets.ts",
    "@shared/palette-source": "./shared/palette-source.ts",
    "@shared/video-frame": "./shared/video-frame.ts",
    "@shared/photo-presets": "./shared/photo-presets.ts",
    "@shared/photo-tools": "./shared/photo-tools.ts",
  },
  "triggers": { "crons": ["* * * * *"] },
  // Run near the US-hosted engines; Gemini refuses requests from some regions.
  "placement": { "mode": "smart" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "level-social-media",
      "database_id": "0f54801b-3420-49a6-839b-1dadbcb85c0a",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "level-social-media" }],
  "limits": { "cpu_ms": 300000 },
  "vars": {
    "HIGGSFIELD_MODEL": "nano-banana-pro",
    "HIGGSFIELD_BASE_URL": "https://api.higgsfield.ai",
    "MAX_CONCURRENT_GENERATIONS": "6",
    "PUBLIC_BASE_URL": "https://studio.levelmena.com",
    "CANONICAL_ORIGIN": "https://studio.levelmena.com",
  },
}
