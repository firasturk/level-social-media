{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studio",
  "main": "server/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": { "enabled": true },
  "alias": {
    "@shared/config": "./shared/config.ts",
    "@shared/config-schema": "./shared/config-schema.ts",
    "@shared/prompts": "./shared/prompts.ts",
    "@shared/naming": "./shared/naming.ts",
    "@shared/types": "./shared/types.ts",
    "@shared/editorial-skill": "./shared/editorial-skill.ts",
    "@shared/pricing": "./shared/pricing.ts",
    "@shared/skills": "./shared/skills.ts",
    "@shared/zaid": "./shared/zaid.ts",
    "@shared/safety": "./shared/safety.ts",
    "@shared/paths": "./shared/paths.ts",
    "@shared/direction-rules": "./shared/direction-rules.ts",
    "@shared/zip-parts": "./shared/zip-parts.ts",
    "@shared/clients": "./shared/clients.ts",
    "@shared/posts": "./shared/posts.ts",
    "@shared/overlay": "./shared/overlay.ts",
    "@shared/brief": "./shared/brief.ts",
    "@shared/occasions": "./shared/occasions.ts",
    "@shared/qa": "./shared/qa.ts",
    "@shared/cast": "./shared/cast.ts",
    "@shared/styles": "./shared/styles.ts",
    "@shared/profile": "./shared/profile.ts",
    "@shared/drive": "./shared/drive.ts",
    "@shared/testgrid": "./shared/testgrid.ts",
  },
  "triggers": { "crons": ["* * * * *"] },
  // Run near the US-hosted engines; Gemini refuses requests from some regions.
  "placement": { "mode": "smart" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "level-social-media",
      "database_id": "0f54801b-3420-49a6-839b-1dadbcb85c0a",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "level-social-media" }],
  "limits": { "cpu_ms": 300000 },
  "vars": {
    "HIGGSFIELD_MODEL": "nano-banana-pro",
    "HIGGSFIELD_BASE_URL": "https://api.higgsfield.ai",
    "MAX_CONCURRENT_GENERATIONS": "6",
    "PUBLIC_BASE_URL": "https://levelstudio.pages.dev",
    "CANONICAL_ORIGIN": "https://levelstudio.pages.dev",
  },
}
